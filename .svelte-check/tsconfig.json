{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json"
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.svelte",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.d.svelte.ts"
  ],
  "exclude": [
    "../src/App.svelte",
    "../src/components/ArrangeDialog.svelte",
    "../src/components/Dialog.svelte",
    "../src/components/ExpPanel.svelte",
    "../src/components/ModuleIcon.svelte",
    "../src/components/ModulePanel.svelte",
    "../src/components/SliderRow.svelte",
    "../src/components/SystemPanel.svelte",
    "../src/components/Toggle.svelte"
  ]
}